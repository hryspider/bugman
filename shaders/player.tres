code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ShellColor : source_color = vec4(1.000000, 1.000000, 0.000000, 1.000000);



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// ColorConstant:8
	vec4 n_out8p0 = vec4(1.000000, 1.000000, 0.000000, 1.000000);


// ColorParameter:10
	vec4 n_out10p0 = ShellColor;


	vec3 n_out9p0;
// If:9
	float n_in9p2 = 0.00001;
	if(abs(n_out2p0.x - n_out8p0.x) < n_in9p2)
	{
		n_out9p0 = vec3(n_out10p0.xyz);
	}
	else if(n_out2p0.x < n_out8p0.x)
	{
		n_out9p0 = vec3(n_out2p0.xyz);
	}
	else
	{
		n_out9p0 = vec3(n_out2p0.xyz);
	}


// Output:0
	COLOR.rgb = n_out9p0;


}
"
